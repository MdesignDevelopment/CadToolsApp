<Window x:Class="CadToolsApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CAD Tools — Standalone"
        Width="700" Height="520"
        MinWidth="540" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Width"    Value="140"/>
            <Setter Property="Height"   Value="70"/>
            <Setter Property="Margin"   Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor"   Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- File picker -->
        <GroupBox Grid.Row="0" Header="DXF File" Padding="8,4" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtFilePath" Grid.Column="0"
                         IsReadOnly="True" VerticalContentAlignment="Center"
                         Padding="4,2" Background="#F5F5F5"
                         Text="No file loaded"/>
                <Button Grid.Column="1" Content="Open…" Width="70"
                        Margin="6,0,0,0" Click="Open_Click"/>
                <Button Grid.Column="2" Content="Save" Width="55"
                        Margin="4,0,0,0" Click="Save_Click"
                        x:Name="btnSave" IsEnabled="False"/>
            </Grid>
        </GroupBox>

        <!-- Action buttons -->
        <WrapPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button Style="{StaticResource ToolBtn}" x:Name="btnStreetView"
                    IsEnabled="False" Click="StreetView_Click">
                <StackPanel>
                    <TextBlock Text="Street View" FontWeight="Bold"/>
                    <TextBlock Text="Download images" FontSize="10"
                               Foreground="#666" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" x:Name="btnCrossSection"
                    IsEnabled="False" Click="CrossSection_Click">
                <StackPanel>
                    <TextBlock Text="Cross Section" FontWeight="Bold"/>
                    <TextBlock Text="Build &amp; draw profile" FontSize="10"
                               Foreground="#666" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" x:Name="btnCleanup"
                    IsEnabled="False" Click="Cleanup_Click">
                <StackPanel>
                    <TextBlock Text="Layer Cleanup" FontWeight="Bold"/>
                    <TextBlock Text="Turn off target layers" FontSize="10"
                               Foreground="#666" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ToolBtn}" x:Name="btnCreatePlans"
                    IsEnabled="False" Click="CreatePlans_Click">
                <StackPanel>
                    <TextBlock Text="Create Plans" FontWeight="Bold"/>
                    <TextBlock Text="Sheet, table &amp; title block" FontSize="10"
                               Foreground="#666" Margin="0,3,0,0"/>
                </StackPanel>
            </Button>
        </WrapPanel>

        <!-- Log -->
        <GroupBox Grid.Row="2" Header="Log" Padding="0">
            <ScrollViewer x:Name="scroll" VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="txtLog"
                         IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11"
                         Background="#1E1E1E" Foreground="#D4D4D4"
                         Padding="8" BorderThickness="0"
                         VerticalScrollBarVisibility="Disabled"/>
            </ScrollViewer>
        </GroupBox>

        <!-- Status bar -->
        <StatusBar Grid.Row="3" Margin="0,6,0,0">
            <StatusBarItem>
                <TextBlock x:Name="lblStatus" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
