<Window x:Class="CadToolsApp.Dialogs.CrossSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Cross-Section Builder"
        Width="960" Height="700"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="200" MaxWidth="480"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition Width="*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: section list + interactive panorama + capture -->
        <Grid Grid.Column="0" Margin="10,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Cross-section points:"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>

            <ListBox x:Name="lstSections" Grid.Row="1"
                     SelectionChanged="LstSections_Changed"/>

            <TextBlock Grid.Row="2"
                       Text="Street View — drag to look around, then capture:"
                       FontWeight="SemiBold" Margin="0,8,0,3" TextWrapping="Wrap"/>

            <Border Grid.Row="3" BorderBrush="#AAAAAA" BorderThickness="1" MinHeight="200">
                <wv2:WebView2 x:Name="webView"/>
            </Border>

            <StackPanel Grid.Row="4" Margin="0,6,0,0">
                <Button x:Name="btnCapture" Content="Capture this view"
                        Click="Capture_Click" Padding="6,6" IsEnabled="False"/>
                <TextBlock x:Name="lblCaptureStatus"
                           Text="Select a section to load the panorama"
                           FontSize="10" Foreground="#888"
                           HorizontalAlignment="Center" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Column="1" Width="5"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      Background="#DDDDDD" Cursor="SizeWE"/>

        <!-- RIGHT: settings + captured thumbnail + queue status + buttons -->
        <Grid Grid.Column="2" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Select cross-section layout"
                       FontWeight="SemiBold" Margin="0,0,0,10"/>

            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Label Content="Section ID:" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Width="85"/>
                <TextBox x:Name="txtId" Padding="4,3" VerticalAlignment="Center"/>
            </DockPanel>

            <DockPanel Grid.Row="2" Margin="0,0,0,12">
                <Label Content="Preset:" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Width="60"/>
                <ComboBox x:Name="cmbPreset" SelectionChanged="PresetChanged"/>
            </DockPanel>

            <!-- Captured image thumbnail — landscape strip, double-click to preview -->
            <Border Grid.Row="3"
                    Height="160"
                    BorderBrush="#AAAAAA" BorderThickness="1"
                    Margin="0,0,0,10"
                    Cursor="Hand" MouseLeftButtonDown="Thumbnail_Click">
                <Grid>
                    <Image x:Name="imgCapture" Stretch="Uniform"/>
                    <TextBlock Text="Captured image will appear here&#x0a;Double-click to preview full size"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" Foreground="#AAAAAA" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Reference imgCapture}, Path=Source}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Queue status -->
            <Border Grid.Row="4" BorderBrush="#AAAAAA" BorderThickness="1"
                    Padding="10" Margin="0,0,0,10" VerticalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Queue each section, then click Done to append all at once."
                               FontSize="11" Foreground="#555" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="lblQueueStatus"
                               Text="No sections queued yet."
                               FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnQueue" Content="Queue section" Width="110" Margin="0,0,6,0"
                        Click="Append_Click"/>
                <Button x:Name="btnQueueAll" Content="Queue all" Width="90" Margin="0,0,6,0"
                        Click="AppendAll_Click"/>
                <Button x:Name="btnDone" Content="Done" Width="60" Margin="0,0,6,0"
                        IsDefault="True" IsEnabled="False" Click="Done_Click"/>
                <Button Content="Cancel" Width="60" IsCancel="True"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
