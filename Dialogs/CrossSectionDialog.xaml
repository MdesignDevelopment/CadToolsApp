<Window x:Class="CadToolsApp.Dialogs.CrossSectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cross-Section Builder"
        Width="760" Height="680"
        MinWidth="660" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: section list + street view -->
        <Grid Grid.Column="0" Margin="10,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="185"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Cross-section points:"
                       FontWeight="SemiBold" Margin="0,0,0,4"/>

            <ListBox x:Name="lstSections" Grid.Row="1"
                     SelectionChanged="LstSections_Changed"/>

            <TextBlock Grid.Row="2" Text="Street View — select one:"
                       FontWeight="SemiBold" Margin="0,6,0,3"/>

            <Grid Grid.Row="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="← Left" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="Right →" FontSize="10" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,2"/>

                <Border x:Name="borderLeft" Grid.Row="1" Grid.Column="0"
                        BorderBrush="#1E90FF" BorderThickness="2"
                        Margin="0,0,3,0" Cursor="Hand"
                        MouseLeftButtonDown="ImgLeft_Click">
                    <Grid>
                        <Image x:Name="imgLeft" Stretch="Uniform"/>
                        <TextBlock Text="No image"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10" Foreground="#AAAAAA">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Reference imgLeft}, Path=Source}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Border x:Name="borderRight" Grid.Row="1" Grid.Column="1"
                        BorderBrush="#AAAAAA" BorderThickness="2"
                        Margin="3,0,0,0" Cursor="Hand"
                        MouseLeftButtonDown="ImgRight_Click">
                    <Grid>
                        <Image x:Name="imgRight" Stretch="Uniform"/>
                        <TextBlock Text="No image"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10" Foreground="#AAAAAA">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Reference imgRight}, Path=Source}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="2" Grid.Column="0"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <RadioButton x:Name="rbImgLeft" Content="Use this" FontSize="10"
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 GroupName="imgSel" IsChecked="True"
                                 Checked="ImgSelection_Changed"/>
                    <Button Content="↗" FontSize="10" Padding="3,1"
                            ToolTip="Full preview (or double-click image)"
                            Click="PreviewLeft_Click" Cursor="Hand"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1"
                            Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                    <RadioButton x:Name="rbImgRight" Content="Use this" FontSize="10"
                                 VerticalAlignment="Center" Margin="0,0,5,0"
                                 GroupName="imgSel"
                                 Checked="ImgSelection_Changed"/>
                    <Button Content="↗" FontSize="10" Padding="3,1"
                            ToolTip="Full preview (or double-click image)"
                            Click="PreviewRight_Click" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- RIGHT: type, preset, zone builder -->
        <Grid Grid.Column="1" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cross-section ID -->
            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                <Label Content="Cross-section ID:" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Width="120"/>
                <TextBox x:Name="txtId" Padding="4,2" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Type -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <Label Content="Type:" VerticalAlignment="Center" Width="60"/>
                <RadioButton x:Name="rbFull" Content="Volledig profiel"
                             VerticalAlignment="Center" Margin="0,0,16,0"
                             IsChecked="True" Checked="TypeChanged"/>
                <RadioButton x:Name="rbSide" Content="Zijdelings werk"
                             VerticalAlignment="Center" Checked="TypeChanged"/>
            </StackPanel>

            <!-- Preset -->
            <DockPanel Grid.Row="2" Margin="0,0,0,8">
                <Label Content="Preset:" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Width="60"/>
                <ComboBox x:Name="cmbPreset" SelectionChanged="PresetChanged"/>
            </DockPanel>

            <!-- Zone type buttons -->
            <WrapPanel x:Name="pnlButtons" Grid.Row="3" Margin="0,0,0,6"/>

            <!-- Zone list -->
            <ListBox x:Name="lstZones" Grid.Row="4"
                     SelectionChanged="LstZones_Changed"
                     FontFamily="Consolas" FontSize="12"
                     Margin="0,0,0,4"/>

            <!-- Edit selected zone -->
            <Border Grid.Row="5" BorderBrush="#AAAAAA" BorderThickness="1"
                    Padding="6,4" Margin="0,0,0,6" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="58"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Type:" VerticalAlignment="Center" Width="46"/>
                    <ComboBox x:Name="cmbType" Grid.Column="1" Margin="0,0,10,0"
                              SelectionChanged="TypeEditChanged"/>
                    <Label Grid.Column="2" Content="Width (m):" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtWidth" Grid.Column="3" Padding="4,2"
                             TextChanged="WidthChanged"/>
                </Grid>
            </Border>

            <!-- Zone action buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Remove" Width="65" Margin="0,0,5,0" Click="Remove_Click"/>
                <Button Content="↑"     Width="30" Margin="0,0,4,0" Click="Up_Click"/>
                <Button Content="↓"     Width="30"                  Click="Down_Click"/>
            </StackPanel>

            <!-- Template DWG -->
            <DockPanel Grid.Row="7" Margin="0,0,0,8">
                <Label Content="Template DWG:" DockPanel.Dock="Left"
                       VerticalAlignment="Center" Width="100"/>
                <Button Content="Browse…" DockPanel.Dock="Right" Width="65"
                        Margin="4,0,0,0" Click="Browse_Click"/>
                <TextBox x:Name="txtTemplate" Padding="4,2" IsReadOnly="True"
                         Background="#F5F5F5" FontSize="10"
                         VerticalContentAlignment="Center"/>
            </DockPanel>

            <!-- Insertion point -->
            <Border Grid.Row="8" BorderBrush="#AAAAAA" BorderThickness="1"
                    Padding="6,4" Margin="0,0,0,8" CornerRadius="3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Insert at  X:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtInsX" Grid.Column="1" Padding="4,2" Text="0"/>
                    <Label Grid.Column="2" Content="  Y:" VerticalAlignment="Center"/>
                    <TextBox x:Name="txtInsY" Grid.Column="3" Padding="4,2" Text="0"/>
                </Grid>
            </Border>

            <!-- Draw / Cancel -->
            <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Draw"   Width="80" Margin="0,0,8,0"
                        IsDefault="True" Click="Draw_Click"/>
                <Button Content="Cancel" Width="80" IsCancel="True"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
